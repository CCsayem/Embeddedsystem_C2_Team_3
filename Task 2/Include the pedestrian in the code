
//This one is not final code for task 2 , only tested version 




// Car traffic lights
int greenLED = 11;
int yellowLED = 12;
int redLED = 13;


// Pedestrian traffic lights
int pedGreenLED = 9;
int pedRedLED = 10;

// Pedestrian button
int buttonPin = 2;

// Traffic light states
int state = 1;

// Timer
unsigned long startTime = 0;

// Button request
bool pedestrianRequest = false;
bool lastButtonState = HIGH;

// Time in milliseconds
unsigned long greenTime = 10000;
unsigned long yellowTime = 5000;
unsigned long redTime = 4000;
unsigned long waitTime = 2000;
unsigned long pedGreenTime = 10000;

void setup() {
  pinMode(greenLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(redLED, OUTPUT);

  pinMode(pedGreenLED, OUTPUT);
  pinMode(pedRedLED, OUTPUT);

  pinMode(buttonPin, INPUT_PULLUP);

  startTime = millis();
}

void loop() {

  // Check if the button is pressed
  bool currentButtonState = digitalRead(buttonPin);

  if (currentButtonState == LOW &&
      lastButtonState == HIGH) {
    pedestrianRequest = true;
  }

  lastButtonState = currentButtonState;

  switch (state) {

    case 1:  // Car green
      digitalWrite(greenLED, HIGH);
      digitalWrite(yellowLED, LOW);
      digitalWrite(redLED, LOW);

      digitalWrite(pedGreenLED, LOW);
      digitalWrite(pedRedLED, HIGH);

      if (millis() - startTime >= greenTime) {
        state = 2;
        startTime = millis();
      }
      break;

    case 2:  // Car yellow
      digitalWrite(greenLED, LOW);
      digitalWrite(yellowLED, HIGH);
      digitalWrite(redLED, LOW);

      digitalWrite(pedGreenLED, LOW);
      digitalWrite(pedRedLED, HIGH);

      if (millis() - startTime >= yellowTime) {
        state = 3;
        startTime = millis();
      }
      break;

    case 3:  // Car red
      digitalWrite(greenLED, LOW);
      digitalWrite(yellowLED, LOW);
      digitalWrite(redLED, HIGH);

      digitalWrite(pedGreenLED, LOW);
      digitalWrite(pedRedLED, HIGH);

      if (pedestrianRequest &&
          millis() - startTime >= waitTime) {
        state = 4;
        startTime = millis();
      }
      else if (!pedestrianRequest &&
               millis() - startTime >= redTime) {
        state = 5;
        startTime = millis();
      }
      break;

    case 4:  // Pedestrian green, car red
      digitalWrite(greenLED, LOW);
      digitalWrite(yellowLED, LOW);
      digitalWrite(redLED, HIGH);

      digitalWrite(pedGreenLED, HIGH);
      digitalWrite(pedRedLED, LOW);

      if (millis() - startTime >= pedGreenTime) {
        pedestrianRequest = false;
        state = 6;
        startTime = millis();
      }
      break;

    case 5:  // Normal cycle: car red ends
      digitalWrite(greenLED, LOW);
      digitalWrite(yellowLED, LOW);
      digitalWrite(redLED, HIGH);

      digitalWrite(pedGreenLED, LOW);
      digitalWrite(pedRedLED, HIGH);

      if (millis() - startTime >= redTime) {
        state = 1;
        startTime = millis();
      }
      break;

    case 6:  // Both red after pedestrian crossing
      digitalWrite(greenLED, LOW);
      digitalWrite(yellowLED, LOW);
      digitalWrite(redLED, HIGH);

      digitalWrite(pedGreenLED, LOW);
      digitalWrite(pedRedLED, HIGH);

      if (millis() - startTime >= waitTime) {
        state = 1;
        startTime = millis();
      }
      break;
  }
}
